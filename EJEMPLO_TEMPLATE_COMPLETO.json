{
  "name": "Diploma Universitario Completo",
  "description": "Template completo de diploma universitario con diseño visual",
  "jsonLd": {
    "@context": [
      "https://www.w3.org/2018/credentials/v1",
      "https://w3id.org/blockcerts/v3.1",
      {
        "display": "https://w3id.org/blockcerts#display",
        "displayHtml": "https://w3id.org/blockcerts#displayHtml",
        "content": "https://w3id.org/blockcerts#displayContent",
        "contentMediaType": "https://w3id.org/blockcerts#displayContentMediaType"
      }
    ],
    "type": ["VerifiableCredential", "BlockcertsCredential"],
    "issuer": {
      "id": "{issuerDid}",
      "name": "{issuerName}",
      "url": "{issuerUrl}",
      "image": "{issuerLogo}"
    },
    "issuanceDate": "{{date}}",
    "credentialSubject": {
      "id": "mailto:{{email}}",
      "name": "{{studentName}}",
      "courseName": "{{courseName}}",
      "certificate": {
        "version": "1.0",
        "metadata": {
          "institution": "{issuerName}",
          "program": "{{courseName}}"
        },
        "design": {
          "type": "canvas",
          "width": 1200,
          "height": 850,
          "background": "#f0f9ff",
          "elements": [
            {
              "type": "rect",
              "x": 0,
              "y": 0,
              "width": 1200,
              "height": 8,
              "fill": "#0369a1"
            },
            {
              "type": "text",
              "content": "CERTIFICADO DE LOGRO",
              "x": 600,
              "y": 179,
              "fontFamily": "sans-serif",
              "fontSize": 48,
              "fontWeight": "bold",
              "textAnchor": "middle",
              "fill": "#0369a1"
            },
            {
              "type": "text",
              "content": "Se otorga a",
              "x": 494,
              "y": 270,
              "fontFamily": "sans-serif",
              "fontSize": 20,
              "fontWeight": "normal",
              "textAnchor": "middle",
              "fill": "#64748b"
            },
            {
              "type": "text",
              "content": "{{studentName}}",
              "x": 520,
              "y": 376,
              "fontFamily": "sans-serif",
              "fontSize": 56,
              "fontWeight": "bold",
              "textAnchor": "middle",
              "fill": "#1e293b"
            },
            {
              "type": "text",
              "content": "Por completar exitosamente el curso",
              "x": 576,
              "y": 462,
              "fontFamily": "sans-serif",
              "fontSize": 24,
              "fontWeight": "normal",
              "textAnchor": "middle",
              "fill": "#475569"
            },
            {
              "type": "text",
              "content": "{{courseName}}",
              "x": 592,
              "y": 532,
              "fontFamily": "sans-serif",
              "fontSize": 32,
              "fontWeight": "bold",
              "textAnchor": "middle",
              "fill": "#0369a1"
            },
            {
              "type": "text",
              "content": "Fecha: {{date}}",
              "x": 606,
              "y": 590,
              "fontFamily": "sans-serif",
              "fontSize": 18,
              "fontWeight": "normal",
              "textAnchor": "middle",
              "fill": "#64748b"
            },
            {
              "type": "image",
              "href": "{issuerLogo}",
              "x": 874,
              "y": 628,
              "width": 150,
              "height": 150
            },
            {
              "type": "polygon",
              "points": "150,650 161,672 185,664 177,688 200,700 177,711 185,735 161,727 150,750 138,727 114,735 122,711 100,700 122,688 114,664 138,672",
              "fill": "#0369a1",
              "opacity": 0.2
            }
          ]
        }
      }
    },
    "display": {
      "contentMediaType": "text/html",
      "content": "<div style=\"width: 100%; height: auto; min-height: 850px; background-color: #f0f9ff; overflow: hidden;\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 850\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid meet\"><rect x=\"0\" y=\"0\" width=\"1200\" height=\"8\" fill=\"#0369a1\" /><text x=\"505\" y=\"179\" font-family=\"sans-serif\" font-size=\"48\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#0369a1\">CERTIFICADO DE LOGRO</text><text x=\"494\" y=\"270\" font-family=\"sans-serif\" font-size=\"20\" font-weight=\"normal\" text-anchor=\"middle\" fill=\"#64748b\">Se otorga a</text><text x=\"520\" y=\"376\" font-family=\"sans-serif\" font-size=\"56\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#1e293b\">{{studentName}}</text><text x=\"576\" y=\"462\" font-family=\"sans-serif\" font-size=\"24\" font-weight=\"normal\" text-anchor=\"middle\" fill=\"#475569\">Por completar exitosamente el curso</text><text x=\"592\" y=\"532\" font-family=\"sans-serif\" font-size=\"32\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#0369a1\">{{courseName}}</text><text x=\"606\" y=\"590\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"normal\" text-anchor=\"middle\" fill=\"#64748b\">Fecha: {{date}}</text><image x=\"874\" y=\"628\" width=\"150\" height=\"150\" href=\"{issuerLogo}\" /><polygon points=\"150,650 161,672 185,664 177,688 200,700 177,711 185,735 161,727 150,750 138,727 114,735 122,711 100,700 122,688 114,664 138,672\" fill=\"#0369a1\" opacity=\"0.2\" /></svg></div>"
    },
    "metadata": {
      "name": "Certificado de {{studentName}}",
      "description": "Emitido por {issuerName} el {{date}}"
    }
  }
}







