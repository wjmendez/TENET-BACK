# Compiled Output (NestJS / TypeScript)
# ============================================
/dist
/build
*.tsbuildinfo
*.js.map
*.d.ts.map

# Archivos JS compilados en src (si se generan accidentalmente)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts.map

# ============================================
# Prisma Generated Files
# ============================================
