# .env.example
# Copia este archivo como .env y completa los valores sensibles en tu entorno local o de producción.
# NUNCA subas tu archivo .env real a git ni compartas secrets en canales públicos.

# PostgreSQL connection string
DATABASE_URL="postgresql://certs_user:YOUR_DB_PASSWORD@localhost:5432/certs"

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (object storage) configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY

# JWT secret (cambia esto por una clave fuerte en producción)
JWT_SECRET="your-jwt-secret"

# Ethereum Sepolia/Infura
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
ETHEREUM_PRIVATE_KEY=YOUR_ETHEREUM_PRIVATE_KEY
ETHEREUM_ANCHOR_CONTRACT=0x5B1F999c7724f8ed66C89f282eB2FEf12C79Ea05

APP_URL=http://localhost:3000

# Issuer configuration for Blockcerts
ISSUER_NAME="Your Institution Name"
ISSUER_PUBLIC_KEY_HEX=YOUR_ISSUER_PUBLIC_KEY_HEX