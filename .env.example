# .env.example
# Copia este archivo como .env y completa los valores sensibles en tu entorno local o de producción.
# NUNCA subas tu archivo .env real a git ni compartas secrets en canales públicos.

# Base de datos
DATABASE_URL="postgresql://certs_user:YOUR_DB_PASSWORD@localhost:5432/certs"

# Cache / colas
REDIS_HOST=localhost
REDIS_PORT=6379

# Object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY

# JWT (HS256)
JWT_SECRET="your-jwt-secret"
JWT_ISSUER=certiflow
JWT_AUDIENCE=certiflow-api

# Local KMS (base64 32 bytes)
LOCAL_KMS_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# Superadmin global (emails separados por coma)
SUPERADMIN_EMAILS=admin@certiflow.local

# Usuario admin por defecto (solo desarrollo)
DEFAULT_ADMIN_EMAIL=admin@certiflow.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NAME="Super Admin"

# App URLs
APP_URL=http://localhost:3100
TENANT_BASE_DOMAIN=certiflow.local
TENANT_HEADER=x-tenant-slug

# Status List 2021
STATUS_LIST_SIZE=100000

# Issuer
ISSUER_NAME="Your Institution Name"
ISSUER_PUBLIC_KEY_HEX=YOUR_ISSUER_PUBLIC_KEY_HEX
ISSUER_JWK_X=BASE64URL_ENCODED_X
ISSUER_JWK_Y=BASE64URL_ENCODED_Y

# Blockchain (anchors)
BESU_PUBLIC_RPC_URL=http://localhost:8545
BESU_RPC_URL=http://localhost:8545
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
ETHEREUM_PRIVATE_KEY=YOUR_ETHEREUM_PRIVATE_KEY
ETHEREUM_ANCHOR_CONTRACT=0x5B1F999c7724f8ed66C89f282eB2FEf12C79Ea05

# NFT
NFT_CONTRACT_ADDRESS=0xYourNftContractAddress
NFT_PRIVATE_KEY=YOUR_NFT_PRIVATE_KEY
BESU_PRE_FUNDED_KEY=YOUR_BESU_PRE_FUNDED_KEY

# Pinata (IPFS)
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_KEY=YOUR_PINATA_SECRET_KEY

# Debug
DEBUG_CANON=0
